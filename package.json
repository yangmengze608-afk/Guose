    "test:grill": "node scripts/verify-grill-installation.mjs",
    "demo:workflow": "node scripts/public-demo-workflow.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "execa": "^9.6.0",
    "postcss": "^8.5.6",
    "postcss-value-parser": "^4.2.0",
    "typescript": "^5.9.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.7.2",
    "eslint": "^10.11.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
