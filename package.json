{
  "name": "guose",
  "version": "0.1.0-rc.1",
  "description": "Intent-first, evidence-aware frontend transformation with human review and isolated demo execution.",
  "license": "MIT",
  "files": ["dist", "LICENSE", "README.md", "THIRD_PARTY_NOTICES.md", "docs/licenses"],
  "keywords": ["react", "tailwind", "design-intent", "static-analysis", "frontend-transformation"],
