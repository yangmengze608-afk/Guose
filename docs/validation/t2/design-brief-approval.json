    "brief": {
      "goal": "保留原页面的功能和结构，但视觉上明显从“AI SaaS 模板感”切换到“现代、克制、有东方气质”的新系统。",
      "style": "现代、克制、有东方气质",
      "keywords": [
        "克制",
        "安静",
        "有留白",
        "有层次"
      ],
      "traditionalStrength": 0.3,
      "preserve": [
        "layout",
        "content-structure",
        "information-hierarchy",
        "interaction",
